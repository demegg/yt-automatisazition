# Copy to .env and fill in your API credentials



# Backend URL (for OAuth callbacks — use your production API domain when deployed)

BACKEND_URL=http://127.0.0.1:8890

FRONTEND_URL=http://localhost:5173



# Comma-separated browser origins allowed to call the API (add your production domain)

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173



# Required in production — random secret for user login sessions

JWT_SECRET=change-this-to-a-long-random-string



# YouTube — Google Cloud Console → OAuth client (one app for all ShortForge users)

# Redirect URIs (add production URLs when deployed):

#   http://127.0.0.1:8890/api/social/youtube/callback

#   http://localhost:8890/api/social/youtube/callback

#   https://api.yoursite.com/api/social/youtube/callback

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=



# TikTok — developers.tiktok.com (one app for all ShortForge users)

TIKTOK_CLIENT_KEY=

TIKTOK_CLIENT_SECRET=

