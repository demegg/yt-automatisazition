# Copy to .env and fill in your API credentials



# Backend URL (for OAuth callbacks — use your production API domain when deployed)

BACKEND_URL=http://127.0.0.1:8890

FRONTEND_URL=http://localhost:5173



# Comma-separated browser origins allowed to call the API (add your production domain)

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173



# Required in production. Use a long random string.
# If AUTH_REQUIRED=true and this is missing, sessions fall back to a dev secret — do not deploy that way.
JWT_SECRET=change-this-to-a-long-random-string

# Set to true on any public server so anonymous visitors are not a shared guest account.
AUTH_REQUIRED=true

# Set true when the site is served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Largest accepted upload, in megabytes. Applies to each video or audio file.
MAX_UPLOAD_MB=2048

# Optional single directory for the database, uploads, and output. Leave unset to use the project folders.
# SHORTFORGE_DATA_DIR=

# Public site origin used when building robots.txt and sitemap.xml (no trailing slash).
# VITE_SITE_URL=https://example.com

# Optional address shown in the marketing footer. Omit it rather than inventing one.
# VITE_CONTACT_EMAIL=hello@example.com



# YouTube — Google Cloud Console → OAuth client (one app for all ShortForge users)

# Redirect URIs (add production URLs when deployed):

#   http://127.0.0.1:8890/api/social/youtube/callback

#   http://localhost:8890/api/social/youtube/callback

#   https://api.yoursite.com/api/social/youtube/callback

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=



# TikTok — developers.tiktok.com (one app for all ShortForge users)

TIKTOK_CLIENT_KEY=

TIKTOK_CLIENT_SECRET=

